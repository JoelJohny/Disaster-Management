# ============================================================================
#  Production environment. NOT a file to commit filled in, and not a file the
#  host needs: set these as environment variables in the platform's dashboard.
#
#  On Railway, the DB_* values are references to the MySQL service rather than
#  literals — type them exactly as shown, braces and all, and Railway
#  substitutes the private-network address at deploy time. The database is
#  then never exposed to the internet.
# ============================================================================

DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}

NODE_ENV=production

# Railway injects PORT. Do not set it yourself unless the host requires it.
# PORT=3000

# Serve the Angular bundle from this same process. Leave true: the session
# cookie is first-party and SameSite=Lax precisely because there is one origin.
SERVE_STATIC=true

# Generate a fresh one. Never the value from .env.example — that is public.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

SESSION_HOURS=12
