# ============================================================================
#  Copy to .env and adjust. .env itself is gitignored and must never be committed.
#
#      cp .env.example .env
# ============================================================================

# ---- database --------------------------------------------------------------
# Port 3307, not 3306: docker-compose maps it there so a local MySQL install
# on the default port does not conflict.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=drms_app
DB_PASSWORD=drms_app
DB_NAME=drms

# ---- server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Serve the built Angular app from the API process (single origin).
# Set false when running `ng serve` separately on port 4200.
SERVE_STATIC=true

# ---- authentication --------------------------------------------------------
# CHANGE THIS. Any deployment reachable by anyone else needs a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789

# How long a session lasts before the user must sign in again.
SESSION_HOURS=12
