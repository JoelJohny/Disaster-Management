{
  "name": "disasteraid",
  "version": "1.0.0",
  "private": true,
  "description": "DisasterAid — web-based disaster relief coordination system",
  "workspaces": [
    "packages/contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "db:reset": "docker exec -i drms-mysql mysql -uroot -prootpw < db/reset.sql",
    "db:verify": "node scripts/db-verify.mjs",
    "db:deploy": "node scripts/db-deploy.mjs",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run start --workspace frontend",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "race": "node scripts/race-test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
